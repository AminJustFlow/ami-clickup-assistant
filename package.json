  "dependencies": {
    "@next/env": "^16.4.0",
    "@prisma/client": "^6.19.0",
    "next": "latest",
    "openai": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "^6.19.0",
    "tsx": "latest",
    "typescript": "latest"
  }
