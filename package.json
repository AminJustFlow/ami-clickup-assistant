    "clickup:sync": "tsx scripts/initial-sync.ts",
    "clickup:sync:voth": "tsx scripts/sync-voth.ts",
    "clients:preview": "tsx scripts/import-clients.ts",
    "clients:import": "tsx scripts/import-clients.ts --apply",
    "clients:analyze": "tsx scripts/analyze-clients-ai.ts",
    "clients:estimate": "tsx scripts/estimate-ai-cost.ts",
    "clickup:audit-detail": "tsx scripts/audit-clickup-detail.ts",
    "clients:audit-groups": "tsx scripts/audit-client-groups.ts",
    "clients:audit-scope": "tsx scripts/audit-folder-scope.ts",
    "clients:audit-unattributed": "tsx scripts/audit-unattributed-folders.ts",
    "clients:test-groups": "tsx scripts/test-client-grouping.ts",
    "intelligence:test-dependencies": "tsx scripts/test-related-evidence.ts",
